# Kopiere nach .env:  cp .env.example .env
# .env ist in .gitignore und landet NIE auf GitHub.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- NCBI (PubMed, GEO) ---
# Ohne Key: 3 requests/sec. Mit Key: 10 requests/sec.
# Kostenlos unter https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=
NCBI_TOOL_NAME=eosync
NCBI_ADMIN_EMAIL=you@example.com

# --- Cache ---
# leer lassen => SQLite-Fallback (backend/.cache.db)
REDIS_URL=
CACHE_TTL_SECONDS=86400

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
